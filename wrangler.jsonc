{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brcontrolssite",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/studio/api/*"]
  },
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brc-studio",
      "database_id": "1b3bea3d-caa8-4946-a906-701fd8202ccf"
    }
  ]
}
